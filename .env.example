# ==========================================================================
# Twitch Quiz Overlay - Environment Configuration
# ==========================================================================
# Kopiere diese Datei zu .env und passe die Werte an:
# cp .env.example .env

# --------------------------------------------------------------------------
# Server Configuration
# --------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# --------------------------------------------------------------------------
# SHARED_SECRET - KRITISCH FÜR MULTI-PC SETUP!
# --------------------------------------------------------------------------
# Dies ist das Passwort für das Config Panel (PC 3 - Moderator).
# ALLE 3 PCs (2 Overlays + 1 Config) nutzen DEN GLEICHEN Server.
# Der Secret MUSS identisch sein in der Server-.env und beim Login im Config Panel.
#
# Generiere einen sicheren Secret (32 Byte = 64 Hex-Zeichen):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# BEISPIEL (NICHT VERWENDEN, EIGENEN GENERIEREN!):
# SHARED_SECRET=a1b2c3d4e5f678901234567890abcdef1234567890abcdef1234567890abcdef

SHARED_SECRET=dein-super-sicherer-64-stelliger-hex-string-hier-einfuegen

# --------------------------------------------------------------------------
# Optional: Twitch OAuth (für zukünftige Erweiterungen)
# --------------------------------------------------------------------------
# TWITCH_CLIENT_ID=your_twitch_client_id
# TWITCH_CLIENT_SECRET=your_twitch_client_secret
# TWITCH_REDIRECT_URI=https://deine-domain.de/auth/twitch/callback

# --------------------------------------------------------------------------
# Multi-PC Deployment Hinweise:
# --------------------------------------------------------------------------
# 1. Server deployed auf EINEM zentralen Host (Railway, Render, VPS, etc.)
# 2. PC 1 (Overlay Links):   Browser Source → https://dein-server/overlay/
# 3. PC 2 (Overlay Rechts):  Browser Source → https://dein-server/overlay/
# 4. PC 3 (Config/Mod):      Browser → https://dein-server/config/ + SHARED_SECRET
# 5. Alle 3 verbinden sich zum GLEICHEN WebSocket-Server → State ist synchron
#
# WICHTIG: In OBS "Refresh browser when scene becomes active" AUSCHALTEN!
#          Sonst verliert das Overlay die WebSocket-Verbindung beim Szenenwechsel.